<script>
function getIPAddress() {
    document.getElementById("ipResult").innerHTML = "Fetching your IP address...";
    fetch('https://api.ipify.org?format=json')
    .then(response => response.json())
    .then(data => {
        document.getElementById("ipResult").innerHTML = "Your Public IP Address: " + data.ip;
    })
    .catch(error => {
        document.getElementById("ipResult").innerHTML = "Unable to fetch IP address. Please try again.";
        console.error("Error fetching IP:", error);
    });
}
</script>

